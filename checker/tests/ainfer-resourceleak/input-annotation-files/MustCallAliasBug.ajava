import org.checkerframework.checker.calledmethods.qual.*;
import org.checkerframework.checker.mustcall.qual.*;
import java.nio.channels.SocketChannel;
import java.net.Socket;
import java.io.IOException;

@org.checkerframework.framework.qual.AnnotatedFor("org.checkerframework.checker.mustcall.MustCallChecker")
class MustCallAliasBug {

    static class Foo {

        void a() {
        }
    }

    private class MCASuperClass {

        int i;

        MCASuperClass( @org.checkerframework.checker.mustcall.qual.MustCall({}) int i) {
            i = i;
        }

        public void a() {
        }
    }

    private class MCASuperCallBug extends MCASuperClass {

        final @org.checkerframework.checker.mustcall.qual.MustCall({}) SocketChannel channel;

        // :: warning: (required.method.not.called)
        private final @org.checkerframework.checker.mustcall.qual.MustCall({}) Socket socket;

        MCASuperCallBug(int i, SocketChannel channel) {
            super(i);
            this.channel = channel;
            this.socket = channel.socket();
            try {
               socket.setSendBufferSize(2);
            } catch (IOException e) {

            }
        }

        public void a(@org.checkerframework.checker.mustcall.qual.MustCall({ "a" }) MCASuperCall this) {
            try {
                channel.close();
            } catch (Exception ignored) {
            }
        }
    }
}
