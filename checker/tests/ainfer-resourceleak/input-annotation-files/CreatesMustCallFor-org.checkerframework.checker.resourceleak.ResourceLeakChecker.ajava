import org.checkerframework.checker.mustcall.qual.*;
import org.checkerframework.checker.calledmethods.qual.*;

@org.checkerframework.framework.qual.AnnotatedFor("org.checkerframework.checker.resourceleak.ResourceLeakChecker")
class CreatesMustCallFor {

    static class Foo {

        void a(@org.checkerframework.checker.calledmethods.qual.CalledMethods({}) Foo this) {
        }
    }

    static class NonFinalOwningField {

        // expect owning annotation for this field
        @org.checkerframework.checker.mustcall.qual.Owning @org.checkerframework.checker.calledmethods.qual.CalledMethods({}) Foo f;

        @org.checkerframework.checker.mustcall.qual.CreatesMustCallFor
        void initialyzeFooWithoutCMCF() {
            f.a();
            f = new Foo();
        }

        @org.checkerframework.checker.mustcall.qual.CreatesMustCallFor
        void initialyzeFooWithoutCMCF2() {
            // :: warning: (required.method.not.called)
            f = new Foo();
        }

        @org.checkerframework.checker.calledmethods.qual.EnsuresCalledMethods(value = { "this.f" }, methods = { "a" })
        void a() {
            f.a();
        }
    }
}
